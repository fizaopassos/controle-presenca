function initFiltroColaboradores() {
var input = document.getElementById('filtroColaborador');
if (!input) return;

var cards = document.querySelectorAll('#listaCards .card-func');
if (!cards || cards.length === 0) return;

function normalizar(texto) {
return (texto || '')
.toString()
.toLowerCase()
.normalize('NFD')
.replace(/[\u0300-\u036f]/g, '');
}

function filtrar() {
var termo = normalizar(input.value || '');

for (var i = 0; i < cards.length; i++) {
  var card = cards[i];
  var nome = normalizar(card.getAttribute('data-nome') || '');

  if (!termo) {
    card.style.display = '';
  } else {
    card.style.display = (nome.indexOf(termo) !== -1) ? '' : 'none';
  }
}

}

input.addEventListener('input', filtrar);
}

