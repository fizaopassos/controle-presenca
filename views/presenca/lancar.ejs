      '<div class="alert alert-warning">Nenhum colaborador encontrado para este condomínio.</div>';
    atualizarResumo();
    return;
  }

  estado = {};
  listaIds = [];
  window.__colaboradoresRaw = {};

  todos.forEach(function (c) {
    var id = String(c.id);
    if (listaIds.indexOf(id) === -1) listaIds.push(id);
    registrarColaborador(c);
