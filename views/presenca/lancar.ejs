  if (fixos.length === 0) {
    html += '<div class="alert alert-warning">Nenhum colaborador fixo neste condomínio.</div>';
  } else {
    fixos.forEach(function (c) { html += renderCard(c); });
  }

  if (extras.length > 0) {
    html += '<div class="secao-extras mt-4 mb-2">'
