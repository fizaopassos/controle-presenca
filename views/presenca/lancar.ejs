      + '<span class="text-muted small">(colaboradores de outros condomínios presentes aqui hoje)</span>'
      + '</div>';
    extras.forEach(function (c) { html += renderCard(c); });
  }

  html += '</div>'; // fecha #listaCards

  // Falta de Efetivo (mantido igual ao seu)
  html += ''
