<div class="container mt-4">
  <h1 class="h4 mb-4">Lançar Presença Diária</h1>

  <form id="formFiltro">
    <div class="row g-2 align-items-end mb-3">
      <div class="col-md-7">
        <label class="form-label">Condomínio *</label>
        <select class="form-select" id="inputCondominio" name="condominio_id" required>
          <option value="">Selecione...</option>
          <% condominios.forEach(cond => { %>
          <option value="<%= cond.id %>"><%= cond.nome %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label">Data *</label>
        <input type="text" class="form-control" id="inputData" name="data" required>
      </div>
      <div class="col-md-2 d-flex align-items-end">
        <button type="button" id="btnBuscar" class="btn btn-primary w-100" disabled>Buscar</button>
      </div>
    </div>
  </form>

  <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
    <div class="btn-group">
<button type="button"
          class="btn btn-outline-secondary btn-sm dropdown-toggle"
          id="btnSelecionarTodosPresente"
          data-bs-toggle="dropdown"
          aria-expanded="false"
          disabled>
          Aplicar em massa
          </button>
          <ul class="dropdown-menu" aria-labelledby="btnSelecionarTodosPresente">
<li>
<button class="dropdown-item"
type="button"
data-bulk-status="presente"
data-confirm="1"
data-confirm-title="Aplicar em massa"
data-confirm-body="Selecionar todos os não lançados como Presente?"
data-confirm-ok="Aplicar">
Selecionar todos: Presente
</button>
</li>

<li>
<button class="dropdown-item"
type="button"
data-bulk-status="folga"
data-confirm="1"
data-confirm-title="Aplicar em massa"
data-confirm-body="Selecionar todos os não lançados como Folga?"
data-confirm-ok="Aplicar">
Selecionar todos: Folga
</button>
</li>

<li>
<button class="dropdown-item"
type="button"
data-bulk-status="falta"
data-confirm="1"
data-confirm-title="Aplicar em massa"
data-confirm-body="Selecionar todos os não lançados como Falta?"
data-confirm-ok="Aplicar">
Selecionar todos: Falta
</button>
</li>

<li>
<button class="dropdown-item"
type="button"
data-bulk-status="atestado"
data-confirm="1"
data-confirm-title="Aplicar em massa"
data-confirm-body="Selecionar todos os não lançados como Atestado?"
data-confirm-ok="Aplicar">
Selecionar todos: Atestado
</button>
</li>

<li>
<button class="dropdown-item"
type="button"
data-bulk-status="ferias"
data-confirm="1"
data-confirm-title="Aplicar em massa"
data-confirm-body="Selecionar todos os não lançados como Férias?"
data-confirm-ok="Aplicar">
Selecionar todos: Férias
</button>
</li>
</ul>
</ul>
</div>

    <button type="button" class="btn btn-success btn-sm" id="btnConfirmarTudo" disabled>
      Confirmar lançamentos
    </button>
    <span class="ms-auto text-muted" id="resumo"></span>
  </div>

  <div id="alerta" class="alert d-none" role="alert"></div>

  <div id="areaColaboradores">
    <div class="alert alert-info">
      Selecione data e condomínio para carregar os colaboradores.
    </div>
  </div>
</div>

<!-- Modal de confirmação -->
<div class="modal fade" id="confirmLancamentoModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Confirmar lançamentos</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" id="confirmLancamentoBody"></div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-primary" id="btnConfirmarLancamentoModal">Confirmar</button>
      </div>
    </div>
  </div>
</div>

<style>
  .flatpickr-day.dia-vermelho::after,
  .flatpickr-day.dia-amarelo::after,
  .flatpickr-day.dia-verde::after {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    position: absolute;
    bottom: 4px;
    left: 50%;
    transform: translateX(-50%);
  }
  .flatpickr-day.dia-vermelho { position: relative; }
  .flatpickr-day.dia-vermelho::after { background: #dc3545; }
  .flatpickr-day.dia-amarelo  { position: relative; }
  .flatpickr-day.dia-amarelo::after  { background: #ffc107; }
  .flatpickr-day.dia-verde    { position: relative; }
  .flatpickr-day.dia-verde::after    { background: #198754; }

  /* Card externo (cobertura recebida) */
  .card-externo { opacity: 0.92; }
  .card-externo .badge-externo {
    font-size: 0.7rem;
    background: #6f42c1;
    color: #fff;
    padding: 2px 7px;
    border-radius: 6px;
  }

  /* Seção de coberturas recebidas */
  .secao-extras {
    border-left: 4px solid #6f42c1;
    padding-left: 8px;
  }

  .card-pendente,
.card-nao-lancado {
background: #fff3cd;
}

/* opcional: deixa o “Pendente” mais forte */
.card-pendente {
box-shadow: inset 0 0 0 9999px rgba(255, 193, 7, 0.12);
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {

  // ============================
  // CONSTANTES / ESTADO
  // ============================
  var STATUSES = [
    { key: 'presente',     label: 'Presente',     btn: 'btn-outline-success',   btnActive: 'btn-success'   },
    { key: 'falta',        label: 'Falta',        btn: 'btn-outline-danger',    btnActive: 'btn-danger'    },
    { key: 'folga',        label: 'Folga',        btn: 'btn-outline-secondary', btnActive: 'btn-secondary' },
    { key: 'atestado',     label: 'Atestado',     btn: 'btn-outline-warning',   btnActive: 'btn-warning'   },
    { key: 'ferias',       label: 'Férias',       btn: 'btn-outline-info',      btnActive: 'btn-info'      },
    { key: 'em_cobertura', label: 'Em cobertura', btn: 'btn-outline-dark',      btnActive: 'btn-dark'      }
  ];

  var STATUS_COM_OBS       = ['falta', 'folga', 'atestado', 'ferias', 'em_cobertura'];
  var STATUS_COM_COBERTURA = ['falta', 'folga', 'atestado', 'ferias'];

  var estado              = {};
  var listaIds            = [];
  var payloadLancamento   = null;
  var modalConfirmLanc    = null;

  window.__colaboradoresRaw    = {};
  window.__coberturasPorEmpresa = {};
  window.__coberturasLoading   = {};

  var fePostos           = [];
  var debounceCobertura  = null;
  var debounceFaltaEfetivo = null;

  // ============================
  // ELEMENTOS
  // ============================
  var inputData              = document.getElementById('inputData');
  var inputCondominio        = document.getElementById('inputCondominio');
  var btnBuscar              = document.getElementById('btnBuscar');
  var btnConfirmarTudo       = document.getElementById('btnConfirmarTudo');
  var btnSelecionarTodosPresente = document.getElementById('btnSelecionarTodosPresente');
  var areaColaboradores      = document.getElementById('areaColaboradores');
  var resumo                 = document.getElementById('resumo');
  var alerta                 = document.getElementById('alerta');

  var modalEl = document.getElementById('confirmLancamentoModal');
  if (modalEl && window.bootstrap) {
    modalConfirmLanc = new bootstrap.Modal(modalEl);
  }

  // ============================
  // FUNÇÕES DE APOIO
  // ============================
  function hojeISO() {
    var d    = new Date();
    var yyyy = d.getFullYear();
    var mm   = String(d.getMonth() + 1).padStart(2, '0');
    var dd   = String(d.getDate()).padStart(2, '0');
    return yyyy + '-' + mm + '-' + dd;
  }

  function showAlert(type, msg, timeoutMs) {
    alerta.className = 'alert alert-' + type;
    alerta.textContent = msg;
    alerta.classList.remove('d-none');
    var t = (typeof timeoutMs === 'number') ? timeoutMs : 3500;
    if (t > 0) setTimeout(function () { alerta.classList.add('d-none'); }, t);
  }

  function badgeStatus(status) {
    if (!status)                    return { cls: 'bg-warning text-dark',  text: 'Não lançado'   };    
    if (status === 'presente')      return { cls: 'bg-success',            text: 'Presente'      };
    if (status === 'falta')         return { cls: 'bg-danger',             text: 'Falta'         };
    if (status === 'folga')         return { cls: 'bg-secondary',          text: 'Folga'         };
    if (status === 'atestado')      return { cls: 'bg-warning text-dark',  text: 'Atestado'      };
    if (status === 'ferias')        return { cls: 'bg-info text-dark',     text: 'Férias'        };
    if (status === 'em_cobertura')  return { cls: 'bg-dark',               text: 'Em cobertura'  };
    return { cls: 'bg-light text-dark', text: status };
  }

  function escapeHtml(str) {
    return String(str || '')
      .replace(/&/g,  '&amp;')
      .replace(/</g,  '&lt;')
      .replace(/>/g,  '&gt;')
      .replace(/"/g,  '&quot;')
      .replace(/'/g,  '&#039;');
  }

  function needsCobertura(status) {
    return STATUS_COM_COBERTURA.indexOf(status) !== -1;
  }

  function isPendente(id) {
    var s = estado[String(id)];
    if (!s) return false;
    if (s.presente_outro_condominio) return false;
    if (s.eh_externo)                return false;
    var mudouStatus = (s.status !== s.originalStatus);
    var mudouObs    = ((s.observacoes || '') !== (s.originalObs || ''));
    var mudouCob    = ((s.cobertura_id || null) !== (s.originalCobertura_id || null));
    return mudouStatus || mudouObs || mudouCob;
  }

  function shouldEnviar(id) {
    var s = estado[String(id)];
    if (!s) return false;

    // Nunca envia colaboradores que estão presentes em outro condomínio
    if (s.presente_outro_condominio) return false;
    // Nunca envia colaboradores externos (de outro condomínio que vieram cobrir aqui)
    if (s.eh_externo) return false;

    var temStatusAtual      = s.status && s.status !== '';
    var tinhaStatusOriginal = s.originalStatus && s.originalStatus !== '';

    if (!tinhaStatusOriginal && temStatusAtual) return true;

    var mudouStatus = (s.status !== s.originalStatus);
    var mudouObs    = ((s.observacoes || '') !== (s.originalObs || ''));
    var mudouCob    = ((s.cobertura_id || null) !== (s.originalCobertura_id || null));

    return mudouStatus || mudouObs || mudouCob;
  }

  function getIdsParaProcessar() {
    return listaIds.filter(function (id) { return shouldEnviar(String(id)); });
  }

  function atualizarResumo() {
    var total      = listaIds.length;
    var idsProc    = getIdsParaProcessar();
    var pendentes  = 0;
    var jaSalvos   = 0;

    idsProc.forEach(function (id) {
      if (isPendente(id)) pendentes++;
      else jaSalvos++;
    });

    resumo.textContent =
      'Total: ' + total +
      ' | Para lançar: ' + idsProc.length +
      ' | Pendentes: ' + pendentes +
      ' | Já salvos: ' + jaSalvos;

    btnConfirmarTudo.disabled        = (idsProc.length === 0);
    btnSelecionarTodosPresente.disabled = (total === 0);
  }

  function aplicarStatusEmMassa(novoStatus) {
listaIds.forEach(function (id) {
var sid = String(id);
var s = estado[sid];
if (!s) return;

  // Regras de bloqueio (mesmas do resto do sistema)
  if (s.presente_outro_condominio) return;
  if (s.eh_externo)                return;
  if (s.tipo === 'falta_efetivo')  return;

  // Só altera quem estiver SEM lançamento
  var atual = (s.status != null) ? String(s.status) : '';
  if (atual !== '') return;

  // Define o novo status
  s.status = novoStatus;

  // Zera obs se esse status não exige observação
  if (STATUS_COM_OBS.indexOf(novoStatus) === -1) {
    s.observacoes = '';
  }

  // Zera cobertura se esse status não usa cobertura
  if (!needsCobertura(novoStatus)) {
    s.cobertura_id   = null;
    s.cobertura_nome = '';
  }

  // Expande só se não for "presente"
  s.expanded = (novoStatus !== 'presente');

  estado[sid] = s;
  rerenderCardById(sid);
});

atualizarResumo();

}

  function buscarCoberturasPorNome(empresaId, termo, callback) {
    if (!termo || termo.length < 2) { if (typeof callback === 'function') callback([]); return; }
    var url = '/presenca/api/colaboradores/buscar?q=' + encodeURIComponent(termo);
    if (empresaId) url += '&empresa_id=' + encodeURIComponent(empresaId);
    fetch(url)
      .then(function (r) { return r.json(); })
      .then(function (lista) {
        if (!Array.isArray(lista)) lista = [];
        if (typeof callback === 'function') callback(lista);
      })
      .catch(function (e) {
        console.error(e);
        if (typeof callback === 'function') callback([]);
      });
  }

  function carregarPostosFaltaEfetivo(onDone) {
    var condId = inputCondominio.value;
    if (!condId) { fePostos = []; if (typeof onDone === 'function') onDone(); return; }

    fetch('/presenca/api/postos/' + encodeURIComponent(condId))
      .then(async function (resp) {
        var ct = (resp.headers.get('content-type') || '').toLowerCase();
        if (!ct.includes('application/json')) {
          var txt = await resp.text();
          throw new Error('Resposta não-JSON: ' + txt.slice(0, 200));
        }
        return resp.json();
      })
      .then(function (data) {
        var lista = [];
        if (Array.isArray(data))                    lista = data;
        else if (data && Array.isArray(data.postos)) lista = data.postos;
        else if (data && Array.isArray(data.data))   lista = data.data;
        fePostos = lista;

        var sel = document.getElementById('fe-posto-select');
        if (sel) {
          var opts = '<option value="">Selecione o posto</option>';
          fePostos.forEach(function (p) {
            opts += '<option value="' + String(p.id) + '">' + escapeHtml(p.nome || ('Posto #' + p.id)) + '</option>';
          });
          sel.innerHTML = opts;
        }
        if (typeof onDone === 'function') onDone();
      })
      .catch(function (e) {
        console.error(e);
        fePostos = [];
        if (typeof onDone === 'function') onDone();
      });
  }

  // ============================
  // RENDERIZAÇÃO DOS CARDS
  // ============================
  function buildCoberturaInputHtml(c, s) {
    var statusAtual = (s.status != null && s.status !== '') ? s.status : '';
    var mostrar     = needsCobertura(statusAtual);
    var empresaId   = c.empresa_id ? String(c.empresa_id) : '';
    var valorInput  = s.cobertura_nome || '';
    return ''
      + '<div class="mt-2 ' + (mostrar ? '' : 'd-none') + '" id="cob-wrap-' + escapeHtml(c.id) + '">'
      + '  <label class="form-label mb-1">Cobertura (opcional)</label>'
      + '  <input type="text" class="form-control form-control-sm"'
      + '         placeholder="Digite o nome do colaborador cobertura..."'
      + '         value="' + escapeHtml(valorInput) + '"'
      + '         data-action="cobertura-input" data-id="' + escapeHtml(c.id) + '"'
      + '         data-empresa-id="' + escapeHtml(empresaId) + '">' 
      + '  <div class="list-group position-absolute w-100 d-none"'
      + '       id="cob-suggestions-' + escapeHtml(c.id) + '"'
      + '       style="z-index:1050;max-height:200px;overflow-y:auto;"></div>'
      + '</div>';
  }

  function renderCard(c) {
    var id          = String(c.id);
    var s           = estado[id] || {};
    var statusAtual = (s.status != null && s.status !== '') ? s.status : '';
    var obsAtual    = s.observacoes || '';
    var expanded    = !!s.expanded;

    var isFaltaEfetivo        = c.tipo === 'falta_efetivo' || s.tipo === 'falta_efetivo';
    var estaEmOutroCond       = !!s.presente_outro_condominio;
    var nomeOutroCond         = s.presente_outro_condominio_nome || '';
    var isExterno             = !!(s.eh_externo || c.eh_externo);
    var condominioOrigemNome  = s.condominio_origem_nome || c.condominio_origem_nome || '';

    // Status virtual de exibição
    var statusRender = statusAtual;
    if (!statusRender && estaEmOutroCond) statusRender = 'em_cobertura';
    if (isExterno && !statusRender)       statusRender = 'presente';

    // Badge e borda
    var badge = badgeStatus(statusRender);
    if (isExterno) {
      badge = { cls: 'bg-success', text: 'Presente (cobertura)' };
    }

   var pendente = isPendente(id);

var pendBadge = '';
if (estaEmOutroCond || isExterno) {
pendBadge = '<span class="badge bg-success">Confirmado</span>';
} else if (!statusAtual || statusAtual === '') {
// Não lançado ainda => pendente (aberto)
pendBadge = '<span class="badge bg-primary">Pendente</span>';
} else if (pendente) {
// Alterado e ainda não confirmou
pendBadge = '<span class="badge bg-primary">Pendente</span>';
} else {
// Tem status e não mudou nada em relação ao original (já confirmado)
pendBadge = '<span class="badge bg-success">Confirmado</span>';
}

     var naoLancado = (!statusAtual || statusAtual === '') && !estaEmOutroCond && !isExterno && !isFaltaEfetivo;

      var highlightClass = pendente
      ? ' card-pendente'
      : (naoLancado ? ' card-nao-lancado' : '');


    var borderClass =
      isExterno                  ? 'border-purple' :
      estaEmOutroCond            ? 'border-dark' :
      statusRender === 'presente' ? 'border-success' :
      statusRender === 'falta'    ? 'border-danger' :
      statusRender === 'em_cobertura' ? 'border-dark' :
      'border-secondary';

    var empresaText = escapeHtml(c.empresa || 'Sem empresa');
    var postoText   = c.posto_nome ? ' • ' + escapeHtml(c.posto_nome) : '';

    // Sub-título de origem para externos
    var origemHtml = '';
    if (isExterno) {
      origemHtml = '<div class="text-muted small mt-1">'
        + '<span class="badge-externo">Origem: ' + escapeHtml(condominioOrigemNome || 'outro condomínio') + '</span>';
      if (c.origem_colaborador_nome) {
        origemHtml += ' <span class="text-muted">cobrindo ausência de <strong>' + escapeHtml(c.origem_colaborador_nome) + '</strong> (' + escapeHtml(c.origem_status || '') + ')</span>';
      }
      origemHtml += '</div>';
    }

    // Aviso "em outro condomínio" para fixos
    var avisoOutroCond = '';
    if (estaEmOutroCond && !isExterno) {
      avisoOutroCond = '<div class="text-success small mt-1">'
        + '✅ Confirmado: em cobertura no condomínio <strong>' + escapeHtml(nomeOutroCond) + '</strong>'
        + '</div>';
    }

    // Botões de status
    var btns = '';
    if (isExterno) {
      btns = '<span class="text-muted small fst-italic">Colaborador externo — somente visualização.</span>';
    } else if (estaEmOutroCond) {
      btns = '<span class="text-muted small fst-italic">Trabalhando em outro condomínio nesta data.</span>';
    } else if (isFaltaEfetivo) {
      btns = '<span class="badge bg-success">Presente (Falta de efetivo)</span>';
    } else {
      STATUSES.forEach(function (st) {
        var active = (st.key === statusRender);
        var cls    = active ? st.btnActive : st.btn;
        btns += '<button type="button" class="btn ' + cls + ' btn-sm"'
          + ' data-action="set-status" data-id="' + id + '" data-status="' + st.key + '">'
          + st.label + '</button> ';
      });
    }

    var obsVisible  = (STATUS_COM_OBS.indexOf(statusRender) !== -1) && !isExterno && !estaEmOutroCond;
    var obsHtml = ''
      + '<div class="mt-2 ' + (obsVisible ? '' : 'd-none') + '" id="obs-wrap-' + id + '">'
      + '  <label class="form-label mb-1">Observação</label>'
      + '  <input type="text" class="form-control form-control-sm" id="obs-' + id + '"'
      + '         placeholder="Ex: Folga autorizada, Atestado entregue..."'
      + '         value="' + escapeHtml(obsAtual) + '"'
      + '         data-action="set-obs" data-id="' + id + '"'
      + (isExterno || estaEmOutroCond ? ' disabled' : '') + '>'
      + '</div>';

    var coberturaHtml = (!isExterno && !estaEmOutroCond && !isFaltaEfetivo)
      ? buildCoberturaInputHtml(c, s)
      : '';

    var chevron = expanded ? '▼' : '►';
    var detalhesClass = expanded ? '' : 'd-none';

    // Classe extra para externos
    var cardExtraClass = isExterno ? ' card-externo' : '';

    return ''
      + '<div id="card-' + id + '" class="card mb-2 border-start border-3 ' + borderClass + cardExtraClass + highlightClass + ' card-func" data-nome="' + escapeHtml(c.nome) + '">'
      + '  <div class="card-body p-3">'
      + '    <div class="d-flex justify-content-between align-items-center gap-3">'
      + '      <button type="button" class="btn btn-link p-0 text-decoration-none text-start flex-grow-1"'
      + '              data-action="toggle-details" data-id="' + id + '">'
      + '        <div class="fw-semibold">' + escapeHtml(c.nome) + '</div>'
      + '        <div class="text-muted small">' + empresaText + postoText + '</div>'
      +          origemHtml
      +          avisoOutroCond
      + '      </button>'
      + '      <div class="text-end" style="min-width:140px;">'
      + '        <div><span class="badge ' + badge.cls + '">' + badge.text + '</span></div>'
      + '        <div class="mt-1">' + pendBadge + '</div>'
      + '      </div>'
      + '      <div class="d-flex align-items-center gap-1">'
      + '        <button type="button" class="btn btn-outline-secondary btn-sm"'
      + '                data-action="toggle-details" data-id="' + id + '">'
      +            chevron
      + '        </button>'
      + (isFaltaEfetivo
          ? '<button type="button" class="btn btn-outline-danger btn-sm"'
            + ' data-action="fe-remover" data-id="' + id + '">Remover</button>'
          : '')
      + '      </div>'
      + '    </div>'
      + '    <div id="detalhes-' + id + '" class="mt-3 ' + detalhesClass + '">'
      + '      <div class="d-flex flex-wrap gap-2">' + btns + '</div>'
      +        coberturaHtml
      +        obsHtml
      + '    </div>'
      + '  </div>'
      + '</div>';
  }

  function rerenderCardById(id) {
    var raw = window.__colaboradoresRaw[String(id)];
    if (!raw) return;
    var el = document.getElementById('card-' + String(id));
    if (!el) return;
    el.outerHTML = renderCard(raw);
  }

  // ============================
  // BUSCAR COLABORADORES
  // ============================
  function registrarColaborador(c) {
    var id = String(c.id);
    window.__colaboradoresRaw[id] = c;

    var originalStatus = c.status || '';
    var originalObs    = c.observacoes || '';
    var originalCob    = c.cobertura_id || null;

    estado[id] = {
      status: originalStatus,
      observacoes: originalObs,
