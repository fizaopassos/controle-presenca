    + '           class="form-control form-control-sm"'
    + '           placeholder="Digite o nome do colaborador..."'
    + '           autocomplete="off"'
    + '           list="lista-colaboradores">'
    + '    <datalist id="lista-colaboradores">'
    +          optionsNomes
    + '    </datalist>'
    + '    <div class="form-text">Digite para filtrar. Ao apagar o texto, todos os cards voltam.</div>'
    + '  </div>'
    + '</div>';

  // Container dos cards (para o filtro agir só aqui)
  html += '<div id="listaCards">';

  html += '<div class="mb-2 mt-2">'
    + '<span class="fw-semibold">Efetivo do condomínio</span>'
