fetch('/presenca/api/colaboradores/condominio/' + condId + '?data=' + encodeURIComponent(data))
.then(function (resp) { return resp.json(); })
.then(function (respData) {
var fixos  = [];
var extras = [];

  // Compatibilidade: aceita array (backend antigo) ou objeto {fixos, extras}
  if (Array.isArray(respData)) {
    fixos  = respData;
    extras = [];
  } else {
    fixos  = Array.isArray(respData.fixos)  ? respData.fixos  : [];
    extras = Array.isArray(respData.extras) ? respData.extras : [];
  }

  var todos = fixos.concat(extras);

  if (todos.length === 0) {
    estado = {};
    listaIds = [];
