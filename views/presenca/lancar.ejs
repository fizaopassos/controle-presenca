    if (!n) return;
    if (nomesMap[n]) return;
    nomesMap[n] = true;
    optionsNomes += '<option value="' + escapeHtml(n) + '"></option>';
  });

  // Render HTML
  var html = '';

  // Campo de filtro por colaborador
  html += ''
    + '<div class="row mb-3">'
