<%
const titulo = (acao === 'novo') ? 'Novo Colaborador' : 'Editar Colaborador';

// Voltar (simples e seguro)
let voltarUrl = '/colaboradores';
if (colaborador && colaborador.tipo === 'fixo' && colaborador.condominio_id) {
voltarUrl = '/colaboradores?condominio_id=' + colaborador.condominio_id;
}
// Se você tiver uma rota própria de coberturas (ex.: /colaboradores/coberturas),
// dá pra trocar aqui quando for cobertura.
%>

<div class="container-fluid py-3">
<div class="d-flex align-items-center justify-content-between mb-3">
<div>
<h4 class="mb-0"><%= titulo %></h4>
<div class="text-muted">Preencha os dados abaixo e salve.</div>
</div>

<a class="btn btn-outline-secondary" href="<%= voltarUrl %>">Voltar</a>

</div>

<div class="card shadow-sm">
<div class="card-body">
<%- include('colaboradores/_form', {
colaborador,
acao,
empresas,
postos,
condominios,
isModal: false
}) %>
</div>
</div>
</div>

views/colaboradores/_form.ejs (com aviso da data + funcionando em modal e fora do modal)

Abaixo está o _form COMPLETO já com:

    aviso em negrito na data de início
    HTMX só quando isModal=true (pra não quebrar na página cheia)
    cancel botão: modal fecha / página volta
    show/hide + required conforme Tipo

<%
const isNovo = (acao === 'novo');
const modal = (typeof isModal !== 'undefined') ? !!isModal : false;

const postUrl  = isNovo
? '/colaboradores/novo'
: '/colaboradores/editar/' + colaborador.id;

const hxTarget = isNovo
? '#tabelaColaboradores'
: '#colaborador-' + colaborador.id;

const hxSwap = isNovo ? 'beforeend' : 'outerHTML';

const tipoAtual = (colaborador && colaborador.tipo) ? colaborador.tipo : 'fixo';

const dataInicioVal = (() => {
if (colaborador && colaborador.data_inicio) {
if (typeof colaborador.data_inicio === 'string') return colaborador.data_inicio.slice(0, 10);
try { return new Date(colaborador.data_inicio).toISOString().slice(0, 10); } catch (e) {}
}
return new Date().toISOString().slice(0, 10);
})();

const ativoAtual = (colaborador && typeof colaborador.ativo !== 'undefined')
? (colaborador.ativo ? true : false)
: true;

let voltarUrl = '/colaboradores';
if (colaborador && colaborador.tipo === 'fixo' && colaborador.condominio_id) {
voltarUrl = '/colaboradores?condominio_id=' + colaborador.condominio_id;
}
%>

<form
id="formColaboradorHtmx"
class="row g-3"
method="post"
action="<%= postUrl %>"
<%- modal ? hx-post="${postUrl}" hx-target="${hxTarget}" hx-swap="${hxSwap}" : '' %>

<div class="col-12">
<h5 class="mb-2"><%= isNovo ? 'Novo Colaborador' : 'Editar Colaborador' %></h5>
</div>

<div class="col-12" id="alertaColaboradorModal"></div>

<div class="col-12 col-lg-6">
<label class="form-label" for="nome">Nome *</label>
<input
class="form-control"
id="nome"
name="nome"
required
value="<%= colaborador ? colaborador.nome : '' %>"
>
</div>

<div class="col-12 col-lg-3">
<label class="form-label" for="empresa_id">Empresa *</label>
<select class="form-select" id="empresa_id" name="empresa_id" required>
<option value="">Selecione...</option>
<% empresas.forEach(e => { %>
<option value="<%= e.id %>" <%= (colaborador && Number(colaborador.empresa_id) === Number(e.id)) ? 'selected' : '' %>>
<%= e.nome %>
</option>
<% }) %>
</select>
</div>

<div class="col-12 col-lg-3">
<label class="form-label" for="tipo">Tipo *</label>
<select class="form-select" id="tipo" name="tipo" required>
<option value="fixo" <%= tipoAtual === 'fixo' ? 'selected' : '' %>>Fixo</option>
<option value="cobertura" <%= tipoAtual === 'cobertura' ? 'selected' : '' %>>Cobertura</option>
</select>
</div>

<div class="col-12 col-lg-4" id="grupoDataInicio">
<label class="form-label" for="data_inicio">Data de início *</label>
<input
type="date"
class="form-control"
id="data_inicio"
name="data_inicio"
value="<%= dataInicioVal %>"
>
<small class="text-muted" id="helpDataInicio">
<strong>Impacto:</strong> o colaborador entra no lançamento a partir desta data e passa a contar para pendências no calendário.
Se você informar uma data retroativa, dias anteriores podem aparecer como pendentes até serem lançados/confirmados.
</small>
</div>

<div class="col-12 col-lg-4" id="grupoCondominio">
<label class="form-label" id="labelCondominio" for="condominio_id">Condomínio *</label>
<select class="form-select" id="condominio_id" name="condominio_id">
<option value="">Selecione...</option>
<% condominios.forEach(cond => { %>
<option value="<%= cond.id %>" <%= (colaborador && Number(colaborador.condominio_id) === Number(cond.id)) ? 'selected' : '' %>>
<%= cond.nome %>
</option>
<% }) %>
</select>
<small class="text-muted" id="helpCondominio">
Para colaboradores de Cobertura, este campo pode ficar em branco.
</small>
</div>

<div class="col-12 col-lg-4" id="grupoPosto">
<label class="form-label" id="labelPosto" for="posto_id">Posto *</label>
<select class="form-select" id="posto_id" name="posto_id">
<option value="">Selecione...</option>
<% postos.forEach(p => { %>
<option value="<%= p.id %>" <%= (colaborador && Number(colaborador.posto_id) === Number(p.id)) ? 'selected' : '' %>>
<%= p.nome %>
</option>
<% }) %>
</select>
<small class="text-muted" id="helpPosto">
Para colaboradores de Cobertura, este campo pode ficar em branco.
</small>
</div>

<div class="col-12 col-lg-3">
<label class="form-label d-block">Ativo</label>
<div class="form-check form-switch">
<input
class="form-check-input"
type="checkbox"
id="ativo"
name="ativo"
<%= ativoAtual ? 'checked' : '' %>
>
<label class="form-check-label" for="ativo">Colaborador ativo</label>
</div>
</div>

<div class="col-12 d-flex gap-2 justify-content-end mt-2">
<% if (modal) { %>
<button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
<% } else { %>
<a class="btn btn-outline-secondary" href="<%= voltarUrl %>">Cancelar</a>
<% } %>

<button type="submit" class="btn btn-primary">
  <%= isNovo ? 'Cadastrar' : 'Salvar' %>
</button>

</div>
</form>

<script>
(function () {
const tipoEl = document.getElementById('tipo');

const grupoDataInicio = document.getElementById('grupoDataInicio');
const dataInicioEl = document.getElementById('data_inicio');

const grupoCondominio = document.getElementById('grupoCondominio');
const condEl = document.getElementById('condominio_id');

const grupoPosto = document.getElementById('grupoPosto');
const postoEl = document.getElementById('posto_id');

function aplicarRegrasTipo() {
  const tipo = (tipoEl.value || 'fixo').toLowerCase();
  const isFixo = (tipo === 'fixo');

  if (isFixo) {
    grupoDataInicio.classList.remove('d-none');
    grupoCondominio.classList.remove('d-none');
    grupoPosto.classList.remove('d-none');

    dataInicioEl.required = true;
    condEl.required = true;
    postoEl.required = true;
  } else {
    grupoDataInicio.classList.add('d-none');
    grupoCondominio.classList.add('d-none');
    grupoPosto.classList.add('d-none');

    dataInicioEl.required = false;
    condEl.required = false;
    postoEl.required = false;
  }
}

tipoEl.addEventListener('change', aplicarRegrasTipo);
aplicarRegrasTipo();

})();
</script>